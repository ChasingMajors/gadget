{
  "manifest_version": 3,
  "name": "CM Rarity Gadget",
  "version": "4.0.8",
  "description": "Chasing Majors rarity intelligence overlays for sports card listings on eBay, COMC, and Sportlots.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CM Rarity Gadget",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://www.ebay.com/*",
    "https://www.comc.com/*",
    "https://www.sportlots.com/*",
    "https://api.chasingmajors.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.ebay.com/*",
        "https://www.comc.com/*",
        "https://www.sportlots.com/*"
      ],
      "js": [
        "config.js",
        "storage.js",
        "parser.js",
        "api.js",
        "ui.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css",
        "icons/cm-logo.png"
      ],
      "matches": [
        "https://www.ebay.com/*",
        "https://www.comc.com/*",
        "https://www.sportlots.com/*"
      ]
    }
  ]
}
